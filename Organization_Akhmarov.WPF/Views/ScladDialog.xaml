<Window x:Class="Organization_Akhmarov.WPF.ScladDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад" Height="280" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource ForegroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Название склада:" FontSize="14" FontWeight="Bold" 
                   Margin="0,0,0,8"/>
        <TextBox x:Name="TxtScladName" Grid.Row="1" Margin="0,0,0,20" 
                 FontSize="14" Padding="8,5"/>

        <TextBlock Grid.Row="2" Text="Адрес:" FontSize="14" FontWeight="Bold" 
                   Margin="0,0,0,8"/>
        <TextBox x:Name="TxtScladAddress" Grid.Row="3" Margin="0,0,0,25" 
                 FontSize="14" Padding="8,5"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" 
                    HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="BtnOk" Content="OK" Width="142" Height="40"
                    Margin="0,0,10,0" Click="BtnOk_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="Отмена" Width="126" Height="38"
                    Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>